---
import { actions } from "astro:actions";
import SubLayout from "../layouts/SubLayout.astro";
import { isDoorbellOpen, upcomingEvents } from "../lib/events";
import { formatEventTime } from "../lib/time";

export const prerender = false;

const { user } = Astro.locals;

// Reload with GET after a successful form so refreshing doesn't resubmit
const rsvpResult = Astro.getActionResult(actions.events.rsvp);
const cancelResult = Astro.getActionResult(actions.events.cancelRsvp);
const doorbellResult = Astro.getActionResult(actions.events.ringDoorbell);
const results = [rsvpResult, cancelResult, doorbellResult];
if (results.some((result) => result && !result.error)) return Astro.redirect("/events");
const error = results.find((result) => result?.error)?.error?.message;

const events = await upcomingEvents(user?.id ?? null);
// Refresh while waiting at the door, so members see when they've been let in
const waiting = events.some((item) => item.myStatus === "at_door");
---

<SubLayout title="Events">
    {error && <p role="alert" class="py-2">{error}</p>}
    {waiting && <script is:inline>setTimeout(() => location.reload(), 5000);</script>}

    {events.length === 0 && <p class="py-4">No upcoming events yet. Check the Discord for news.</p>}

    <ul class="flex flex-col gap-6 py-4">
        {
            events.map((item) => {
                const full = item.capacity !== null && item.going >= item.capacity;
                return (
                    <li class="border p-2 flex flex-col gap-1">
                        <h2>{item.title}</h2>
                        <p>{formatEventTime(item.startsAt, item.endsAt)}</p>
                        {item.location && <p>{item.location}</p>}
                        {item.description && <p class="whitespace-pre-line">{item.description}</p>}
                        <p>
                            {item.going} going
                            {item.capacity !== null && ` of ${item.capacity} spots`}
                        </p>

                        {!user ? (
                            <a href="/login">log in to RSVP</a>
                        ) : item.myStatus === "present" ? (
                            <p>you're in ✓ welcome!</p>
                        ) : item.myStatus === "at_door" ? (
                            <p>🔔 you've rung the doorbell. Someone's coming to let you in…</p>
                        ) : isDoorbellOpen(item) ? (
                            <form method="POST" action={actions.events.ringDoorbell}>
                                <input type="hidden" name="eventId" value={item.id} />
                                <button class="doorbell">🔔 ring the doorbell</button>
                            </form>
                        ) : item.myStatus === "going" ? (
                            <form method="POST" action={actions.events.cancelRsvp}>
                                <input type="hidden" name="eventId" value={item.id} />
                                <span>you're going ✓</span>
                                <button>can't make it</button>
                            </form>
                        ) : full ? (
                            <p>full</p>
                        ) : (
                            <form method="POST" action={actions.events.rsvp}>
                                <input type="hidden" name="eventId" value={item.id} />
                                <button>I'm going</button>
                            </form>
                        )}
                    </li>
                );
            })
        }
    </ul>
</SubLayout>

<style>
    a,
    button {
        text-decoration: underline;
        cursor: pointer;
    }

    button {
        border: 1px solid var(--color-primary);
        padding: 0 0.5rem;
        margin-left: 0.5rem;
    }

    form > button:first-child {
        margin-left: 0;
    }

    .doorbell {
        font-size: 1.5rem;
        padding: 0.5rem 1rem;
        margin-top: 0.5rem;
    }
</style>
