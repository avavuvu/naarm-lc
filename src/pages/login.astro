---
import SubLayout from "../layouts/SubLayout.astro";
import LoginForm from "../components/LoginForm.svelte";
import { socialLogins } from "../lib/auth";

export const prerender = false;

if (Astro.locals.user) return Astro.redirect("/profile");

// Better Auth sends people back here with ?error= when a login fails
const errors: Record<string, string> = {
    INVALID_TOKEN: "That login link has expired or was already used. Request a new one below.",
};
const code = Astro.url.searchParams.get("error");
const error = code ? (errors[code] ?? "Something went wrong logging in. Please try again.") : "";
---

<SubLayout title="Log in">
    <LoginForm providers={socialLogins} error={error} client:load />
</SubLayout>
