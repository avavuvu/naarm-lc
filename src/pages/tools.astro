---
import { tools } from "../content/tools";
import SubLayout from "../layouts/SubLayout.astro";
---

<SubLayout title="Tools">
  <p>Tools created by our community</p>

  <ul class="grid grid-cols-2 gap-2">
    {
      tools.map((tool) => (
        <li class="border grid grid-cols-2 gap-1">
          <div>
            <h2>
              <a class="underline" href={tool.href}>
                {tool.name}
              </a>
            </h2>
            <p>{tool.description}</p>
          </div>
          <a href={tool.href}>
            <img src={tool.img} alt={tool.alt} />
          </a>
        </li>
      ))
    }
  </ul>
</SubLayout>
