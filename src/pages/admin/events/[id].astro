---
import { actions } from "astro:actions";
import SubLayout from "../../../layouts/SubLayout.astro";
import EventForm from "../../../components/admin/EventForm.astro";
import Avatar from "../../../components/Avatar.svelte";
import { attendees, eventById, guests } from "../../../lib/events";

export const prerender = false;

const deleted = Astro.getActionResult(actions.events.delete);
if (deleted && !deleted.error) return Astro.redirect("/admin/events");

const updated = Astro.getActionResult(actions.events.update);
if (updated && !updated.error) return Astro.redirect(Astro.url.pathname);

const event = await eventById(Astro.params.id!);
if (!event) return new Response("Event not found", { status: 404 });

const [going, guestList] = await Promise.all([attendees(event.id), guests(event.id)]);
const statusLabels = { going: "", at_door: "at the door", present: "here" };
const error = updated?.error?.message ?? deleted?.error?.message;
---

<SubLayout title={`Admin: ${event.title}`}>
    <p class="flex gap-4">
        <a href="/admin/events">← all events</a>
        <a href={`/admin/doorway?event=${event.id}`}>open the doorway</a>
    </p>
    {error && <p role="alert">{error}</p>}

    <EventForm action={actions.events.update} submitLabel="save changes" event={event} />

    <h2 class="pt-4">
        Going ({event.going}{event.capacity !== null && ` of ${event.capacity}`})
    </h2>
    {going.length === 0 && guestList.length === 0 && <p>No RSVPs yet.</p>}
    <ul class="flex flex-col gap-2 py-2">
        {
            going.map((member) => (
                <li class="flex items-center gap-2">
                    <Avatar name={member.name} image={member.image} />
                    <span>{member.name}</span>
                    {member.username && <span>@{member.username}</span>}
                    {statusLabels[member.status] && <span>· {statusLabels[member.status]}</span>}
                </li>
            ))
        }
        {
            guestList.map((guest) => (
                <li class="flex items-center gap-2">
                    <Avatar name={guest.name} />
                    <span>{guest.name} (guest)</span>
                </li>
            ))
        }
    </ul>

    <form
        method="POST"
        action={actions.events.delete}
        class="py-6"
        onsubmit="return confirm('Delete this event and all its RSVPs?')"
    >
        <input type="hidden" name="eventId" value={event.id} />
        <button>delete event</button>
    </form>
</SubLayout>

<style>
    a,
    button {
        text-decoration: underline;
        cursor: pointer;
    }

    button {
        border: 1px solid var(--color-primary);
        padding: 0.25rem 0.5rem;
    }
</style>
