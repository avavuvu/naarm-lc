---
import { actions } from "astro:actions";
import SubLayout from "../../../layouts/SubLayout.astro";
import EventForm from "../../../components/admin/EventForm.astro";

export const prerender = false;

const result = Astro.getActionResult(actions.events.create);
if (result && !result.error) return Astro.redirect(`/admin/events/${result.data.id}`);
---

<SubLayout title="New event">
    <p><a href="/admin/events">← all events</a></p>
    {result?.error && <p role="alert">Couldn't create the event: {result.error.message}</p>}
    <EventForm action={actions.events.create} submitLabel="create event" />
</SubLayout>
