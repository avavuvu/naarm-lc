---
import SubLayout from "../../layouts/SubLayout.astro";
import Doorway from "../../components/admin/Doorway.svelte";
import { DOORBELL_OPENS_MS, currentEvent, doorwayState } from "../../lib/events";

export const prerender = false;

// Defaults to the event that's on now; ?event= opens any event, e.g. for testing
const eventId = Astro.url.searchParams.get("event") ?? (await currentEvent());
const state = eventId ? await doorwayState(eventId) : null;
if (eventId && !state) return new Response("Event not found", { status: 404 });
---

<SubLayout title="Doorway">
    {
        state ? (
            <Doorway initial={state} client:load />
        ) : (
            <div class="py-4 flex flex-col gap-2">
                <p>No event is on right now.</p>
                <p>
                    The doorway opens {DOORBELL_OPENS_MS / 60_000} minutes before an event starts.
                    You can also open it for any event from <a class="underline" href="/admin/events">the events list</a>.
                </p>
            </div>
        )
    }
</SubLayout>
