---
import SubLayout from "../layouts/SubLayout.astro";
import ProfileForm from "../components/account/ProfileForm.svelte";

export const prerender = false;

const { user } = Astro.locals;
if (!user) return Astro.redirect("/login");

const email = user.email.endsWith(".invalid") ? null : user.email;
---

<SubLayout title="profile" crumbs={[{ label: user.name }]}>
    <div class="flex flex-col items-start gap-8 py-6">
        <ProfileForm name={user.name} email={email} admin={user.role === "admin"} client:load />
    </div>
</SubLayout>
