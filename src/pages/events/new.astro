---
import { actions } from "astro:actions";
import SubLayout from "../../layouts/SubLayout.astro";
import EventForm from "../../components/admin/EventForm.svelte";
import { errorMessage } from "../../lib/errors";
import { eventPath } from "../../lib/paths";

export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.redirect("/login");

const result = Astro.getActionResult(actions.events.create);
if (result && !result.error) return Astro.redirect(eventPath(result.data));
const error = errorMessage(result?.error);
---

<SubLayout title="new event" crumbs={[{ label: "events", href: "/events" }]}>
    {error && <p role="alert">couldn't create the event: {error}</p>}
    <EventForm action={actions.events.create.toString()} submitLabel="create event" />
</SubLayout>
