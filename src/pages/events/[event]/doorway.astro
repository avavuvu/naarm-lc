---
import SubLayout from "../../../layouts/SubLayout.astro";
import DoorwayScreen from "../../../components/admin/DoorwayScreen.svelte";
import { DOORBELL_OPENS_MS, doorwayState } from "../../../lib/events";
import { eventIdFromParam } from "../../../lib/paths";

export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.redirect("/login");

const id = eventIdFromParam(Astro.params.event);
const state = id && (await doorwayState(id));
if (!state) return new Response("event not found", { status: 404 });
---

<SubLayout
    title="doorway"
    crumbs={[
        { label: "events", href: "/events" },
        { label: state.event.title, href: state.event.path },
    ]}
>
    <DoorwayScreen initial={state} opensMinutes={DOORBELL_OPENS_MS / 60_000} client:load />
</SubLayout>
