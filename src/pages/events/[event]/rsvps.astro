---
import SubLayout from "../../../layouts/SubLayout.astro";
import RsvpTable from "../../../components/admin/RsvpTable.svelte";
import { attendees, eventById, guests } from "../../../lib/events";
import { eventIdFromParam, eventPath } from "../../../lib/paths";

export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.redirect("/login");

const id = eventIdFromParam(Astro.params.event);
const event = id && (await eventById(id));
if (!event) return new Response("event not found", { status: 404 });

const [members, guestList] = await Promise.all([attendees(event.id), guests(event.id)]);
---

<SubLayout
    title="rsvps"
    crumbs={[
        { label: "events", href: "/events" },
        { label: event.title, href: eventPath(event) },
    ]}
>
    <RsvpTable event={event} attendees={members} guests={guestList} />
</SubLayout>
