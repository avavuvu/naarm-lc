---
import SubLayout from "../layouts/SubLayout.astro";
import DoorwayScreen from "../components/admin/DoorwayScreen.svelte";
import { DOORBELL_OPENS_MS, currentEvent } from "../lib/events";
import { eventPath } from "../lib/paths";

export const prerender = false;

if (Astro.locals.user?.role !== "admin") return Astro.redirect("/login");

const current = await currentEvent();
if (current) return Astro.redirect(`${eventPath(current)}/doorway`);
---

<SubLayout title="doorway">
    <DoorwayScreen initial={null} opensMinutes={DOORBELL_OPENS_MS / 60_000} client:load />
</SubLayout>
