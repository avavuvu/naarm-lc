---
import SubLayout from "../../layouts/SubLayout.astro";
import MembersIndex from "../../components/members/MembersIndex.svelte";
import { approvedMembers, pendingCount } from "../../lib/members";

export const prerender = false;

const { user } = Astro.locals;
const [members, admin] = await Promise.all([
    approvedMembers(),
    user?.role === "admin" ? pendingCount().then((pending) => ({ pending })) : null,
]);
---

<SubLayout title="members" description="the people of live coders naarm">
    <MembersIndex members={members} loggedIn={Boolean(user)} admin={admin} />
</SubLayout>
