---
import BaseLayout from "../layouts/BaseLayout.astro";
import Logo from "../components/Logo.svelte";
import Footer from "../components/Footer.svelte";
import NextEvent from "../components/events/NextEventIsland.astro";
---

<BaseLayout>
    <main class="max-w-4xl mx-auto">
        <div class="">
            <Logo variant="large" client:load />
        </div>
        <div class="overflow-hidden text-primary py-2">
            <span class="border">
                ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
            </span>
        </div>
        <div class="px-8 pt-8 pb-16 min-h-[50vh] grid gap-16 sm:grid-cols-[1fr_22rem] items-start">
            <div class="flex flex-col gap-10">
                <div>
                    <h1>live coders naarm</h1>
                    <p>
                        creative coding meetups for everyone in melbourne,
                        australia
                    </p>
                </div>

                <nav>
                    <ul class="flex flex-col gap-1">
                        <li>
                            <a href="/discord">join the discord</a>
                        </li>
                        <li>
                            <a href="/events">events</a>
                        </li>
                        <li>
                            <a href="/about">about</a>
                        </li>
                        <li>
                            <a href="/tools">tools</a>
                        </li>
                        <li>
                            <a href="/profile">account</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <NextEvent server:defer>
                <section slot="fallback" class="border bg-surface p-6 min-h-48">
                    <h2>next event</h2>
                </section>
            </NextEvent>
        </div>
    </main>
    <div class="hidden sm:block">
        <div class="absolute -z-10">
            <Logo variant="blank" client:visible />
        </div>
        <div class="max-w-4xl mx-auto pt-12">
            <Footer />
        </div>
    </div>
</BaseLayout>
