---
import EventAction from "./EventAction.svelte";
import NextEvent from "./NextEvent.svelte";
import { eventAction, nextMeetup } from "../../lib/events";
import { eventPath } from "../../lib/paths";

const { user } = Astro.locals;
const next = await nextMeetup(user?.id ?? null);
const action = next && eventAction(next, Boolean(user));
---

<NextEvent event={next}>
    {next && action && <EventAction eventId={next.id} path={eventPath(next)} action={action} ticketUrl={next.url} client:load />}
</NextEvent>
