# Copy to .env.local and fill in. `neon checkout dev` fills the first three.

# Neon Postgres (pooled for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Better Auth. Generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
# Deploy previews only (leave BETTER_AUTH_URL unset there), e.g. deploy-preview-*--naarmlc.netlify.app
# Also set on production so it trusts previews
BETTER_AUTH_PREVIEW_HOSTS=

# Discord login: https://discord.com/developers/applications
# Redirect: <site>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# GitHub login (optional): GitHub → Settings → Developer settings → OAuth Apps
# Callback: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production and previews only: previews send Discord/GitHub logins through production
OAUTH_PROXY_PRODUCTION_URL=
OAUTH_PROXY_SECRET=

# Email login links via Resend (optional locally: links are printed to the dev server log)
RESEND_API_KEY=
EMAIL_FROM=
